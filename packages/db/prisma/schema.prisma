// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Senador {
  codigo       Int           @id
  nome         String
  nomeCompleto String?       @map("nome_completo")
  partido      String?
  uf           String?       @db.Char(2)
  urlFoto      String?       @map("url_foto")
  emExercicio  Boolean       @default(false) @map("em_exercicio")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")
  despesas     Despesa[]
  remuneracoes Remuneracao[]

  @@index([uf])
  @@map("senadores")
}

model Categoria {
  id          Int       @id @default(autoincrement())
  nomeOficial String    @unique @map("nome_oficial")
  nomeCurto   String?   @map("nome_curto")
  slug        String    @unique
  despesas    Despesa[]

  @@map("categorias")
}

model Despesa {
  id            Int       @id
  senadorCodigo Int       @map("senador_codigo")
  senador       Senador   @relation(fields: [senadorCodigo], references: [codigo])
  categoriaId   Int       @map("categoria_id")
  categoria     Categoria @relation(fields: [categoriaId], references: [id])
  ano           Int
  mes           Int
  fornecedor    String
  cpfCnpj       String    @map("cpf_cnpj")
  documento     String?
  data          DateTime? @db.Date
  valor         Decimal   @db.Decimal(12, 2)
  tipoDocumento String?   @map("tipo_documento")

  @@index([senadorCodigo, ano])
  @@index([categoriaId, ano])
  @@map("despesas")
}

model Remuneracao {
  id                      Int     @id @default(autoincrement())
  senadorCodigo           Int     @map("senador_codigo")
  senador                 Senador @relation(fields: [senadorCodigo], references: [codigo])
  ano                     Int
  mes                     Int
  tipoFolha               String  @map("tipo_folha")
  remuneracaoBasica       Decimal @default(0) @map("remuneracao_basica") @db.Decimal(12, 2)
  vantagensPessoais       Decimal @default(0) @map("vantagens_pessoais") @db.Decimal(12, 2)
  gratificacaoNatalina    Decimal @default(0) @map("gratificacao_natalina") @db.Decimal(12, 2)
  diarias                 Decimal @default(0) @db.Decimal(12, 2)
  auxilios                Decimal @default(0) @db.Decimal(12, 2)
  vantagensIndenizatorias Decimal @default(0) @map("vantagens_indenizatorias") @db.Decimal(12, 2)
  outrasEventuais         Decimal @default(0) @map("outras_eventuais") @db.Decimal(12, 2)
  abonoPermanencia        Decimal @default(0) @map("abono_permanencia") @db.Decimal(12, 2)
  horasExtras             Decimal @default(0) @map("horas_extras") @db.Decimal(12, 2)
  previdencia             Decimal @default(0) @db.Decimal(12, 2)
  impostoRenda            Decimal @default(0) @map("imposto_renda") @db.Decimal(12, 2)
  reversaoTeto            Decimal @default(0) @map("reversao_teto") @db.Decimal(12, 2)
  faltas                  Decimal @default(0) @db.Decimal(12, 2)
  remuneracaoLiquida      Decimal @default(0) @map("remuneracao_liquida") @db.Decimal(12, 2)

  @@unique([senadorCodigo, ano, mes, tipoFolha])
  @@map("remuneracoes")
}

model Sincronizacao {
  id           Int       @id @default(autoincrement())
  fonte        String
  ano          Int?
  iniciadaEm   DateTime  @default(now()) @map("iniciada_em")
  finalizadaEm DateTime? @map("finalizada_em")
  status       String
  registros    Int       @default(0)
  erro         String?

  @@map("sincronizacoes")
}
