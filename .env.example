DIRECT_URL="postgresql://senado:senado@localhost:5432/transparencia"

# Produção (Supabase): copie de Connect > ORMs > Prisma, sem o ?pgbouncer=true
# (a API usa a porta 6543; migrate e sync usam a 5432). Caractere especial na senha
# vai codificado: # vira %23.
